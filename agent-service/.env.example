# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# PostgreSQL connection string (SQLAlchemy format)
DATABASE_URL=postgresql://finpilot_user:finpilot_pass@localhost:5432/finpilot

# Port FastAPI runs on (used when running via uvicorn directly)
PORT=8000

# Comma-separated list of origins allowed to call this service.
# In this project only the Node API should ever call it.
ALLOWED_ORIGINS=http://localhost:4000
GEMINI_API_KEY= you api key 